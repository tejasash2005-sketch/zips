# Flask Config
SECRET_KEY=cloudkitchen-super-secret-2024
FLASK_ENV=production

# Database Config
# For Render/Railway, this will be provided automatically as DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/cloudkitchen

# Email Config (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Razorpay Config
RAZORPAY_KEY_ID=rzp_test_your_id
RAZORPAY_KEY_SECRET=your_secret
